{{define "musings"}}
<section class="wip-shell" aria-live="polite">
  <h1>Musings</h1>
  <p class="wip-note">Work in progress. The forge is still chewing on coherent thoughts.</p>
  <div class="tui-loader" role="img" aria-label="Loading Insanity in progress">
    <p>[ loading_insanity.exe ]</p>
    <div class="bar-wrap">
      <div class="bar-fill"></div>
    </div>
    <p class="loader-meta">status: ??? | entropy: rising | tea: depleted</p>
  </div>
</section>
{{end}}
