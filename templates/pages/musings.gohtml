{{define "musings"}}
<section class="wip-shell" aria-live="polite">
  <h1>Musings</h1>
  <p class="wip-note">Work in progress. The forge is still chewing on (mostly) coherent thoughts.</p>
  <div class="tui-loader" role="img" aria-label="Loading Insanity in progress">
    <p>[ loading_insanity.exe ]</p>
    <div class="bar-wrap">
      <div class="bar-fill"></div>
    </div>
    <p class="loader-meta">entropy: rising | energy: draining | status: Defragmenting thoughts<span class="musings-status-dots" data-max-dots="3"></span></p>
  </div>
</section>
{{end}}
