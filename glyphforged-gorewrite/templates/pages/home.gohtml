{{define "home"}}
<section class="hero-panel">
  <img class="hero-logo" src="/public/logos/gf-logo-wht.svg" alt="GlyphForged logo">
  <h1>GlyphForged</h1>
  <p class="hero-sub">Games, software, and musings forged at terminal depth.</p>
</section>
<section class="nav-cards" aria-label="Site sections">
  <a class="card-link" href="/games">
    <h2>Games</h2>
    <p>Games written by me or with my help.</p>
    <span class="card-glyph">[game]</span>
  </a>
  <a class="card-link" href="/projects">
    <h2>Projects</h2>
    <p>Software projects, creative coding, and experiments.</p>
    <span class="card-glyph">[forge]</span>
  </a>
  <a class="card-link" href="/musings">
    <h2>Musings</h2>
    <p>Post-mortems, lessons learned, and other no-sabo musings.</p>
    <span class="card-glyph">[logs]</span>
  </a>
</section>
{{end}}
